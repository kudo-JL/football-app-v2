<div>
  <a href="/leagues" class="text-sm text-slate-500 hover:text-slate-700">← <%= user ? 'دورياتي' : 'كل الدوريات' %></a>
  <header class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-3xl font-bold text-slate-900"><%= league.name %></h1>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700"><%= league.status %></span>
        <% if (league.is_public) { %>
          <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-800">🌍 عام</span>
        <% } else { %>
          <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800">🔒 خاص</span>
        <% } %>
      </div>
      <p class="mt-1 text-sm text-slate-600"><%= league.season %> · <%= league.country || '' %></p>
      <% if (league.description) { %>
        <p class="mt-2 text-sm text-slate-700"><%= league.description %></p>
      <% } %>
    </div>
    <% if (canEdit) { %>
      <div class="flex gap-2">
        <a href="/leagues/<%= league.id %>/edit" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">✏️ تعديل</a>
        <form action="/leagues/<%= league.id %>/delete" method="POST" onsubmit="return confirm('حذف الدوري وكل أقسامه؟')" class="inline">
          <button class="rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">🗑️ حذف</button>
        </form>
      </div>
    <% } %>
  </header>

  <section class="mt-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-slate-900">الأقسام</h2>
      <% if (canEdit) { %>
        <a href="/leagues/<%= league.id %>/sections/new" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ قسم جديد</a>
      <% } %>
    </div>

    <% if (sections.length === 0) { %>
      <div class="rounded-2xl border-2 border-dashed border-slate-300 bg-white p-10 text-center">
        <div class="text-5xl mb-3">📁</div>
        <h3 class="font-semibold text-slate-900">لا توجد أقسام</h3>
        <a href="/leagues/<%= league.id %>/sections/new" class="mt-4 inline-block rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white">+ أنشئ أول قسم</a>
      </div>
    <% } else { %>
      <div class="grid gap-3 sm:grid-cols-2">
        <% sections.forEach(s => { %>
          <a href="/leagues/<%= league.id %>/sections/<%= s.id %>" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md">
            <h3 class="font-semibold text-slate-900"><%= s.name %></h3>
            <p class="mt-1 text-sm text-slate-500"><%= s.team_count %> فريق</p>
            <% if (s.notes) { %>
              <p class="mt-2 text-xs text-slate-500"><%= s.notes %></p>
            <% } %>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>
</div>
