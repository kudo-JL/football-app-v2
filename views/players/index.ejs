<div>
  <a href="/leagues/<%= leagueId %>/sections/<%= section.id %>" class="text-sm text-slate-500 hover:text-slate-700">← <%= section.name %></a>
  <header class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">👥 لاعبو <%= team.name %></h1>
      <p class="mt-1 text-sm text-slate-600"><%= section.name %> · <%= players.length %> لاعب</p>
    </div>
    <a href="/leagues/<%= leagueId %>/sections/<%= section.id %>/teams/<%= team.id %>/players/new" class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700">+ لاعب جديد</a>
  </header>

  <% if (players.length === 0) { %>
    <div class="mt-8 rounded-2xl border-2 border-dashed border-slate-300 bg-white p-10 text-center">
      <div class="text-5xl mb-3">👤</div>
      <h3 class="font-semibold text-slate-900">لا يوجد لاعبون</h3>
      <p class="mt-2 text-sm text-slate-500">أضف لاعبين لهذا الفريق لتبدأ بناء التشكيلة.</p>
      <a href="/leagues/<%= leagueId %>/sections/<%= section.id %>/teams/<%= team.id %>/players/new" class="mt-4 inline-block rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white">+ أضف أول لاعب</a>
    </div>
  <% } else { %>
    <%# Group by position for organized display %>
    <%
      const posOrder = { GK: 1, DEF: 2, MID: 3, FWD: 4 };
      const grouped = { GK: [], DEF: [], MID: [], FWD: [] };
      players.forEach(p => { if (grouped[p.position]) grouped[p.position].push(p); else grouped.MID.push(p); });
      const posLabels = { GK: '🧤 حراس', DEF: '🛡 دفاع', MID: '⚽ وسط', FWD: '🎯 هجوم' };
    %>

    <% Object.keys(posLabels).forEach(function(key) { %>
      <% if (grouped[key].length > 0) { %>
        <section class="mt-6">
          <h2 class="text-sm font-bold text-slate-600 mb-2"><%= posLabels[key] %> (<%= grouped[key].length %>)</h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <% grouped[key].forEach(function(p) { %>
              <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-start gap-3">
                  <div class="shrink-0 h-12 w-12 rounded-full flex items-center justify-center text-base font-bold text-white" style="background-color: <%= team.color || '#64748b' %>">
                    <%= p.jersey_number || '?' %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-semibold text-slate-900 truncate"><%= p.name %></h3>
                    <% if (p.birth_date) { %>
                      <% 
                        const age = Math.floor((Date.now() - new Date(p.birth_date).getTime()) / (365.25 * 24 * 60 * 60 * 1000));
                      %>
                      <p class="text-xs text-slate-500"><%= age %> سنة</p>
                    <% } %>
                    <% if (p.notes) { %>
                      <p class="text-xs text-slate-400 mt-1 truncate" title="<%= p.notes %>"><%= p.notes %></p>
                    <% } %>
                  </div>
                </div>
                <div class="mt-3 flex gap-2">
                  <a href="/leagues/<%= leagueId %>/sections/<%= section.id %>/teams/<%= team.id %>/players/<%= p.id %>/edit" class="flex-1 rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-center text-xs font-medium text-slate-700 hover:bg-slate-50">تعديل</a>
                  <button type="button" onclick="if(confirm('حذف <%= p.name.replace(/'/g, "\\'") %>؟')){document.getElementById('del-<%= p.id %>').submit();}" class="flex-1 rounded-lg border border-red-300 bg-white px-2 py-1.5 text-center text-xs font-medium text-red-700 hover:bg-red-50">حذف</button>
                </div>
                <form id="del-<%= p.id %>" action="/leagues/<%= leagueId %>/sections/<%= section.id %>/teams/<%= team.id %>/players/<%= p.id %>/delete" method="POST" style="display:none;"></form>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>
    <% }); %>
  <% } %>
</div>
