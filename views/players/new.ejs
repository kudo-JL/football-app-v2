<div>
  <a href="/leagues/<%= leagueId %>/sections/<%= section.id %>/teams/<%= team.id %>/players" class="text-sm text-slate-500 hover:text-slate-700">← لاعبو <%= team.name %></a>
  <h1 class="mt-2 text-3xl font-bold text-slate-900">➕ لاعب جديد</h1>
  <p class="mt-1 text-sm text-slate-600"><%= team.name %></p>

  <% if (error) { %>
    <div class="mt-4 rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700"><%= error %></div>
  <% } %>

  <form action="/leagues/<%= leagueId %>/sections/<%= section.id %>/teams/<%= team.id %>/players/new" method="POST" class="mt-8 space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div>
      <label class="mb-1.5 block text-sm font-medium text-slate-700">اسم اللاعب *</label>
      <input type="text" name="name" required value="<%= form.name || '' %>" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" placeholder="مثال: محمد صلاح">
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <label class="mb-1.5 block text-sm font-medium text-slate-700">رقم القميص</label>
        <input type="number" name="jerseyNumber" min="1" max="99" value="<%= form.jerseyNumber || '' %>" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" placeholder="10">
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-medium text-slate-700">تاريخ الميلاد</label>
        <input type="date" name="birthDate" value="<%= form.birthDate || '' %>" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-medium text-slate-700">المركز</label>
        <select name="position" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
          <option value="GK" <%= form.position === 'GK' ? 'selected' : '' %>>🧤 حارس (GK)</option>
          <option value="DEF" <%= form.position === 'DEF' ? 'selected' : '' %>>🛡 مدافع (DEF)</option>
          <option value="MID" <%= form.position === 'MID' || !form.position ? 'selected' : '' %>>⚽ وسط (MID)</option>
          <option value="FWD" <%= form.position === 'FWD' ? 'selected' : '' %>>🎯 مهاجم (FWD)</option>
        </select>
      </div>
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium text-slate-700">رابط الصورة (اختياري)</label>
      <input type="url" name="photo" value="<%= form.photo || '' %>" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" placeholder="https://...">
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium text-slate-700">ملاحظات</label>
      <textarea name="notes" rows="2" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" placeholder="مثال: قائد الفريق، لاعب دولي..."><%= form.notes || '' %></textarea>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <a href="/leagues/<%= leagueId %>/sections/<%= section.id %>/teams/<%= team.id %>/players" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">إلغاء</a>
      <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700">حفظ</button>
    </div>
  </form>
</div>
