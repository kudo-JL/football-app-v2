<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Cairo', 'Segoe UI', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    [hidden] { display: none !important; }
    body { font-family: 'Cairo', 'Segoe UI', system-ui, sans-serif; }
    /* Dark mode overrides */
    html.dark body { background-color: #0f172a; color: #e2e8f0; }
    html.dark .bg-white { background-color: #1e293b !important; }
    html.dark .bg-slate-50 { background-color: #0f172a !important; }
    html.dark .bg-slate-100 { background-color: #334155 !important; }
    html.dark .text-slate-900 { color: #f1f5f9 !important; }
    html.dark .text-slate-700 { color: #cbd5e1 !important; }
    html.dark .text-slate-600 { color: #94a3b8 !important; }
    html.dark .text-slate-500 { color: #94a3b8 !important; }
    html.dark .border-slate-200 { border-color: #334155 !important; }
    html.dark .border-slate-300 { border-color: #475569 !important; }
    html.dark .border-slate-100 { border-color: #334155 !important; }
    html.dark .hover\:bg-slate-50:hover { background-color: #334155 !important; }
    html.dark .hover\:bg-slate-100:hover { background-color: #334155 !important; }
    html.dark .shadow-sm { box-shadow: 0 1px 2px 0 rgba(0,0,0,0.3) !important; }
    html.dark .shadow-md { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3) !important; }
    html.dark nav { background-color: #1e293b !important; border-color: #334155 !important; }
    html.dark footer { background-color: #0f172a !important; border-color: #334155 !important; color: #94a3b8 !important; }
    html.dark input, html.dark select, html.dark textarea { background-color: #334155 !important; color: #f1f5f9 !important; border-color: #475569 !important; }
    html.dark .bg-emerald-50 { background-color: #064e3b !important; }
    html.dark .bg-amber-50 { background-color: #451a03 !important; }
    html.dark .from-emerald-50, html.dark .via-white, html.dark .to-emerald-50\/30, html.dark .to-amber-50\/30 { background: #1e293b !important; }
    html.dark .border-emerald-200 { border-color: #065f46 !important; }
    html.dark .border-amber-200 { border-color: #92400e !important; }
    html.dark .text-emerald-700 { color: #6ee7b7 !important; }
    html.dark .text-amber-700 { color: #fcd34d !important; }
    html.dark .bg-blue-50 { background-color: #1e3a8a !important; }
    html.dark .bg-purple-50 { background-color: #581c87 !important; }
    html.dark .bg-red-50 { background-color: #7f1d1d !important; }
    html.dark .bg-emerald-100 { background-color: #065f46 !important; color: #d1fae5 !important; }
    html.dark .text-emerald-700 { color: #6ee7b7 !important; }
    html.dark .text-amber-700 { color: #fcd34d !important; }
    html.dark .text-amber-800 { color: #fde68a !important; }
    html.dark .text-blue-700 { color: #93c5fd !important; }
    html.dark .text-blue-800 { color: #bfdbfe !important; }
    html.dark .text-purple-700 { color: #d8b4fe !important; }
    html.dark .text-purple-800 { color: #e9d5ff !important; }
    html.dark .text-red-700 { color: #fca5a5 !important; }
    html.dark .text-emerald-800 { color: #a7f3d0 !important; }
    html.dark .border-emerald-200 { border-color: #047857 !important; }
    html.dark .border-amber-200 { border-color: #92400e !important; }
    html.dark .border-blue-200 { border-color: #1e40af !important; }
    html.dark .border-purple-200 { border-color: #6b21a8 !important; }
    html.dark .border-red-200 { border-color: #991b1b !important; }
    html.dark .border-red-300 { border-color: #b91c1c !important; }
    html.dark .border-amber-300 { border-color: #b45309 !important; }
    html.dark .border-emerald-300 { border-color: #047857 !important; }
    html.dark .text-emerald-600 { color: #34d399 !important; }
    html.dark a { color: #93c5fd; }
    html.dark .text-slate-400 { color: #94a3b8 !important; }
    html.dark .text-slate-300 { color: #64748b !important; }
    html.dark .hover\:text-emerald-600:hover { color: #6ee7b7 !important; }
    html.dark .hover\:text-red-800:hover { color: #fca5a5 !important; }
  </style>
  <script>
    // Apply theme immediately to prevent flash
    (function() {
      var t = localStorage.getItem('fa_theme') || 'light';
      if (t === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <% if (user) { %>
  <nav class="sticky top-0 z-50 border-b border-slate-200 bg-white shadow-sm">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
      <a href="/" class="text-xl font-bold text-emerald-600">⚽ <%= appName %></a>
      <div class="flex items-center gap-4 flex-wrap">
        <a href="/leagues" class="text-sm font-medium text-slate-700 hover:text-emerald-600">الدوريات</a>
        <% if (user) { %>
          <a href="/cups" class="text-sm font-medium text-slate-700 hover:text-amber-600">الكؤوس</a>
          <a href="/leagues/new" class="text-sm font-medium text-slate-700 hover:text-emerald-600">+ دوري</a>
        <% } %>
        <% if (user && user.role === 'ADMIN') { %>
          <a href="/admin" class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800 hover:bg-amber-200">👑 الأدمن</a>
        <% } %>
        <button type="button" id="themeToggle" onclick="window.__faToggleTheme()" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-sm hover:bg-slate-50" title="تبديل الوضع">
          <span id="themeIcon">🌙</span>
        </button>
        <% if (user) { %>
          <a href="/account" class="text-sm font-medium text-slate-700 hover:text-emerald-600" title="حسابي">👤 <span class="hidden sm:inline"><%= user.name %></span></a>
          <form action="/logout" method="POST" class="inline">
            <button class="text-sm font-medium text-red-600 hover:text-red-800">خروج</button>
          </form>
        <% } else { %>
          <a href="/login" class="text-sm font-medium text-slate-700 hover:text-emerald-600">دخول</a>
          <a href="/register" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-emerald-700">حساب جديد</a>
        <% } %>
      </div>
    </div>
  </nav>
  <% } %>

  <main class="mx-auto max-w-6xl px-6 py-8">
    <%- body %>
  </main>

  <footer class="mt-12 border-t border-slate-200 bg-white py-6 text-center text-xs text-slate-500">
    <%= appName %> · مبني بـ Express + SQLite · <a href="/health" class="text-slate-400 hover:text-slate-600">health</a>
  </footer>

  <script>
    // Theme toggle (global function)
    window.__faToggleTheme = function() {
      var html = document.documentElement;
      var isDark = html.classList.toggle('dark');
      localStorage.setItem('fa_theme', isDark ? 'dark' : 'light');
      var icon = document.getElementById('themeIcon');
      if (icon) icon.textContent = isDark ? '☀️' : '🌙';
    };
    // Sync icon with current theme
    (function() {
      var isDark = document.documentElement.classList.contains('dark');
      var icon = document.getElementById('themeIcon');
      if (icon) icon.textContent = isDark ? '☀️' : '🌙';
    })();
  </script>
  <%- script %>
</body>
</html>
