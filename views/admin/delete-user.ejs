<div class="mx-auto max-w-2xl">
  <div class="mb-6 flex items-center gap-3">
    <a href="/admin" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">← العودة</a>
    <h1 class="text-2xl font-bold text-red-700">🗑️ تأكيد حذف مستخدم</h1>
  </div>

  <div class="rounded-xl border-2 border-red-300 bg-red-50 p-6">
    <div class="mb-4">
      <p class="text-sm text-slate-700">المستخدم المستهدف:</p>
      <p class="mt-1 text-xl font-bold text-slate-900"><%= target.name %></p>
      <p class="text-sm text-slate-600"><%= target.email %></p>
      <p class="mt-1 text-xs text-slate-500">
        مسجّل في: <%= target.created_at %>
        <% if (target.role === 'ADMIN') { %>
          <span class="mr-2 inline-flex items-center gap-0.5 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800">👑 ADMIN</span>
        <% } %>
        <% if (target.is_verified) { %>
          <span class="mr-2 inline-flex items-center gap-0.5 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">✅ مفعّل</span>
        <% } else { %>
          <span class="mr-2 inline-flex items-center gap-0.5 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800">⚠️ غير مفعّل</span>
        <% } %>
      </p>
    </div>

    <%# Always-visible impact preview — even before user clicks anything %>
    <div class="mt-4 rounded-lg border border-red-200 bg-white p-4">
      <p class="text-sm font-bold text-red-800">⚠️ سيتم حذف ما يلي أيضاً (لا يمكن التراجع):</p>
      <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
        <li class="flex items-center gap-2">
          <span class="inline-block w-24 text-xs text-slate-500">دوريات</span>
          <strong class="text-base text-slate-900"><%= impact.leagues %></strong>
          <span class="text-xs text-slate-500">دوري</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="inline-block w-24 text-xs text-slate-500">أقسام</span>
          <strong class="text-base text-slate-900"><%= impact.sections %></strong>
          <span class="text-xs text-slate-500">قسم</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="inline-block w-24 text-xs text-slate-500">فرق</span>
          <strong class="text-base text-slate-900"><%= impact.teams %></strong>
          <span class="text-xs text-slate-500">فريق</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="inline-block w-24 text-xs text-slate-500">لاعبين</span>
          <strong class="text-base text-slate-900"><%= impact.players %></strong>
          <span class="text-xs text-slate-500">لاعب</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="inline-block w-24 text-xs text-slate-500">مباريات</span>
          <strong class="text-base text-slate-900"><%= impact.matches %></strong>
          <span class="text-xs text-slate-500">مباراة</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="inline-block w-24 text-xs text-slate-500">كؤوس</span>
          <strong class="text-base text-slate-900"><%= impact.cups %></strong>
          <span class="text-xs text-slate-500">كأس</span>
        </li>
      </ul>
      <p class="mt-3 text-xs text-slate-500">سيتم أيضاً حذف شعارات الفرق من القرص.</p>
    </div>

    <%# Confirmation form — always visible (no hidden JS) %>
    <form
      action="/admin/users/<%= target.id %>/delete"
      method="POST"
      class="mt-6 rounded-lg border border-red-300 bg-white p-4"
      onsubmit="return confirm('متأكد تماماً؟\n\nسيتم حذف <%= impact.leagues %> دوري و <%= impact.teams %> فريق و <%= impact.matches %> مباراة و <%= impact.players %> لاعب و <%= impact.cups %> كأس.\n\nلا يمكن التراجع!')"
    >
      <label for="confirm-email" class="block text-sm font-semibold text-slate-800">
        للتأكيد، اكتب إيميل المستخدم: <span class="font-mono text-red-700"><%= target.email %></span>
      </label>
      <input
        type="text"
        id="confirm-email"
        name="confirmEmail"
        autocomplete="off"
        required
        placeholder="<%= target.email %>"
        class="mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-200"
      />
      <p class="mt-1 text-xs text-slate-500">يجب أن يطابق الإيميل تماماً.</p>

      <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
        <a href="/admin" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">إلغاء</a>
        <button
          type="submit"
          class="rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300">
          🗑️ حذف نهائي
        </button>
      </div>
    </form>
  </div>
</div>
