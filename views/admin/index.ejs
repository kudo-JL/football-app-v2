<div>
  <h1 class="text-3xl font-bold text-slate-900">👑 لوحة الأدمن</h1>
  <p class="mt-1 text-sm text-slate-600">إدارة المستخدمين، الدوريات، والكؤوس.</p>

  <% if (typeof query !== 'undefined' && query.msg) { %>
    <div class="mt-4 rounded-lg bg-emerald-50 border border-emerald-200 p-3 text-sm text-emerald-700">
      <% if (query.msg === 'role_updated') { %>✅ تم تحديث دور المستخدم<% } %>
      <% if (query.msg === 'visibility_updated') { %>✅ تم تحديث رؤية الدوري<% } %>
      <% if (query.msg === 'featured_updated') { %>✅ تم تحديث التمييز<% } %>
      <% if (query.msg === 'verified' && query.target) { %>✅ تم تفعيل <strong><%= query.target %></strong> يدوياً<% } %>
      <% if (query.msg === 'user_deleted' && query.target) { %>🗑️ تم حذف <strong><%= query.target %></strong> وكل بياناته<% } %>
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query.error) { %>
    <div class="mt-4 rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700">
      <% if (query.error === 'cannot_demote_self') { %>❌ لا يمكنك إلغاء صلاحية الأدمن من نفسك<% } %>
      <% if (query.error === 'invalid_role') { %>❌ دور غير صالح<% } %>
      <% if (query.error === 'cannot_feature_others') { %>❌ لا يمكنك تمييز دوريات مستخدمين آخرين<% } %>
      <% if (query.error === 'league_not_found') { %>❌ الدوري غير موجود<% } %>
      <% if (query.error === 'user_not_found') { %>❌ المستخدم غير موجود<% } %>
      <% if (query.error === 'already_verified') { %>⚠️ المستخدم مفعّل أصلاً<% } %>
      <% if (query.error === 'cannot_delete_self') { %>❌ لا يمكنك حذف حسابك<% } %>
    </div>
  <% } %>

  <section class="mt-8 grid gap-3 sm:grid-cols-5">
    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <p class="text-xs text-slate-500">المستخدمون</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= stats.users %></p>
    </div>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
      <p class="text-xs text-emerald-700">مفعّلون ✅</p>
      <p class="mt-1 text-2xl font-bold text-emerald-900"><%= stats.verified %></p>
    </div>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <p class="text-xs text-amber-700">أدمن</p>
      <p class="mt-1 text-2xl font-bold text-amber-900"><%= stats.admins %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <p class="text-xs text-slate-500">الدوريات</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= stats.leagues %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <p class="text-xs text-slate-500">الكؤوس</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= stats.cups %></p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900 mb-3">👥 المستخدمون (<%= users.length %>)</h2>
    <% if (user.is_super_admin) { %>
      <p class="text-xs text-emerald-700 mb-2">🛡️ أنت السوبر أدمن — يمكنك التحقق اليدوي والحذف. أنت أول مستخدم مسجّل.</p>
    <% } else { %>
      <p class="text-xs text-slate-500 mb-2">🔒 التحقق اليدوي والحذف متاحان فقط للسوبر أدمن (أول مستخدم مسجّل).</p>
    <% } %>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-xs text-slate-600">
            <th class="px-3 py-2 text-right">الاسم</th>
            <th class="px-3 py-2 text-right">الإيميل</th>
            <th class="px-3 py-2 text-center">الحالة</th>
            <th class="px-3 py-2 text-center">الدور</th>
            <th class="px-3 py-2 text-center">الدوريات</th>
            <th class="px-3 py-2 text-right">تاريخ التسجيل</th>
            <th class="px-3 py-2 text-center">إجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50">
              <td class="px-3 py-2 font-semibold text-slate-900">
                <%= u.name %>
                <% if (u.is_super_admin) { %>
                  <span class="mr-1 inline-flex items-center gap-0.5 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-800" title="أول مستخدم مسجّل — سوبر أدمن">🛡️ SUPER</span>
                <% } %>
              </td>
              <td class="px-3 py-2 text-slate-600"><%= u.email %></td>
              <td class="px-3 py-2 text-center">
                <% if (u.is_verified) { %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800">✅ مفعّل</span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">⚠️ غير مفعّل</span>
                <% } %>
              </td>
              <td class="px-3 py-2 text-center">
                <% if (u.role === 'ADMIN') { %>
                  <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">👑 ADMIN</span>
                <% } else { %>
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">مستخدم</span>
                <% } %>
              </td>
              <td class="px-3 py-2 text-center text-xs text-slate-600">
                <% if (u.league_count > 0) { %>
                  <a href="/leagues?owner=<%= u.id %>" class="font-semibold text-emerald-700 hover:underline"><%= u.league_count %></a>
                <% } else { %>
                  <span class="text-slate-400">0</span>
                <% } %>
              </td>
              <td class="px-3 py-2 text-xs text-slate-500"><%= u.created_at %></td>
              <td class="px-3 py-2 text-center">
                <div class="inline-flex flex-wrap items-center justify-center gap-1">
                  <%# Change role form %>
                  <% if (u.id === user.id) { %>
                    <span class="text-xs text-slate-400">أنت</span>
                  <% } else { %>
                    <form action="/admin/users/<%= u.id %>/role" method="POST" class="inline-flex gap-1">
                      <select name="role" class="rounded border border-slate-300 px-1.5 py-0.5 text-xs">
                        <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>مستخدم</option>
                        <option value="ADMIN" <%= u.role === 'ADMIN' ? 'selected' : '' %>>ADMIN</option>
                      </select>
                      <button class="rounded bg-slate-700 px-2 py-0.5 text-xs text-white hover:bg-slate-800" title="تغيير الدور">حفظ</button>
                    </form>
                  <% } %>

                  <%# Manual verify (super admin only, unverified users) %>
                  <% if (user.is_super_admin && !u.is_verified && u.id !== user.id) { %>
                    <form action="/admin/users/<%= u.id %>/verify" method="POST" class="inline">
                      <button
                        onclick="return confirm('تفعيل يدوي للمستخدم <%= u.email %>؟\n\n(يُستعمل فقط لو فقد إيميله ولا يستطيع استلام رابط التفعيل)')"
                        class="rounded bg-emerald-600 px-2 py-0.5 text-xs text-white hover:bg-emerald-700"
                        title="تفعيل يدوي (بدون إيميل)">✅ فعّل</button>
                    </form>
                  <% } %>

                  <%# Delete user (super admin only, not self) %>
                  <% if (user.is_super_admin && u.id !== user.id) { %>
                    <a href="/admin/users/<%= u.id %>/delete"
                       class="rounded border border-red-300 bg-white px-2 py-0.5 text-xs font-semibold text-red-700 hover:bg-red-50"
                       title="حذف المستخدم وكل بياناته (لا يمكن التراجع)">🗑️ حذف</a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900 mb-3">🏆 الدوريات (<%= leagues.length %>)</h2>
    <p class="text-xs text-slate-500 mb-3">⭐ المميز يظهر في الصفحة الرئيسية للزوار. فقط الأدمن يقدر يميّز دورياته.</p>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-xs text-slate-600">
            <th class="px-3 py-2 text-right">الاسم</th>
            <th class="px-3 py-2 text-right">المالك</th>
            <th class="px-3 py-2 text-center">الأقسام</th>
            <th class="px-3 py-2 text-center">الحالة</th>
            <th class="px-3 py-2 text-center">الرؤية</th>
            <th class="px-3 py-2 text-center">مميز ⭐</th>
          </tr>
        </thead>
        <tbody>
          <% leagues.forEach(l => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50 <%= l.is_featured ? 'bg-amber-50/50' : '' %>">
              <td class="px-3 py-2">
                <a href="/leagues/<%= l.id %>" class="font-semibold text-emerald-700 hover:underline"><%= l.name %></a>
                <p class="text-xs text-slate-500"><%= l.season %></p>
              </td>
              <td class="px-3 py-2 text-slate-600">
                <%= l.owner_name || '—' %>
                <p class="text-xs text-slate-400"><%= l.owner_email || '' %></p>
              </td>
              <td class="px-3 py-2 text-center"><%= l.section_count %></td>
              <td class="px-3 py-2 text-center text-xs"><%= l.status %></td>
              <td class="px-3 py-2 text-center">
                <form action="/admin/leagues/<%= l.id %>/visibility" method="POST" class="inline">
                  <% if (l.is_public) { %>
                    <button class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 hover:bg-emerald-200">🌍 عام</button>
                  <% } else { %>
                    <button name="isPublic" value="on" class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800 hover:bg-amber-200">🔒 خاص</button>
                  <% } %>
                </form>
              </td>
              <td class="px-3 py-2 text-center">
                <% if (l.owner_id === user.id) { %>
                  <form action="/admin/leagues/<%= l.id %>/featured" method="POST" class="inline">
                    <% if (l.is_featured) { %>
                      <button class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-l from-amber-400 to-yellow-500 px-3 py-1.5 text-xs font-bold text-white shadow-sm hover:from-amber-500 hover:to-yellow-600 ring-2 ring-amber-300" title="مميز الآن — اضغط لإلغاء التمييز">
                        <span class="text-base">⭐</span>
                        <span>مميز ✓</span>
                      </button>
                    <% } else { %>
                      <button name="featured" value="on" class="inline-flex items-center gap-1.5 rounded-lg border-2 border-dashed border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-amber-400 hover:bg-amber-50 hover:text-amber-800" title="اضغط للظهور في الصفحة الرئيسية">
                        <span class="text-base">☆</span>
                        <span>تمييز</span>
                      </button>
                    <% } %>
                  </form>
                <% } else { %>
                  <span class="text-xs text-slate-300" title="لا يمكن تمييز دوريات غيرك">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-slate-500">⭐ المميز يظهر في الصفحة الرئيسية للزوار. فقط الأدمن يقدر يميّز دورياته.</p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900 mb-3">🏅 الكؤوس (<%= cups.length %>)</h2>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-xs text-slate-600">
            <th class="px-3 py-2 text-right">الاسم</th>
            <th class="px-3 py-2 text-right">الدوري</th>
            <th class="px-3 py-2 text-right">المالك</th>
            <th class="px-3 py-2 text-center">الحالة</th>
          </tr>
        </thead>
        <tbody>
          <% cups.forEach(c => { %>
            <tr class="border-t border-slate-100">
              <td class="px-3 py-2 font-semibold"><%= c.name %></td>
              <td class="px-3 py-2 text-slate-600"><%= c.league_name || '—' %></td>
              <td class="px-3 py-2 text-slate-600"><%= c.owner_name || '—' %></td>
              <td class="px-3 py-2 text-center text-xs"><%= c.status %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
</div>
