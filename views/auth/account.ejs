<div>
  <h1 class="text-3xl font-bold text-slate-900">👤 حسابي</h1>
  <p class="mt-1 text-sm text-slate-600">إدارة معلوماتك الشخصية وكلمة المرور.</p>

  <% if (success) { %>
    <div class="mt-4 rounded-lg bg-emerald-50 border border-emerald-200 p-3 text-sm text-emerald-700">✅ تم الحفظ بنجاح</div>
  <% } %>
  <% if (error) { %>
    <div class="mt-4 rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700">❌ <%= error %></div>
  <% } %>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-slate-900 mb-3">📊 إحصائياتي</h2>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-slate-500">الدوريات</span><span class="font-bold text-slate-900"><%= stats.leagues %></span></div>
        <div class="flex justify-between"><span class="text-slate-500">الأقسام</span><span class="font-bold text-slate-900"><%= stats.sections %></span></div>
        <div class="flex justify-between"><span class="text-slate-500">الدور</span>
          <span class="font-bold <%= user.role === 'ADMIN' ? 'text-amber-700' : 'text-slate-700' %>"><%= user.role === 'ADMIN' ? '👑 ADMIN' : 'مستخدم' %></span>
        </div>
        <div class="flex justify-between"><span class="text-slate-500">البريد</span><span class="font-mono text-xs text-slate-700"><%= user.email %></span></div>
      </div>
    </div>

    <form action="/account/profile" method="POST" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-slate-900 mb-3">✏️ المعلومات الشخصية</h2>
      <div class="space-y-3">
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">الاسم</label>
          <input type="text" name="name" required minlength="2" value="<%= user.name %>" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-500">البريد (لا يتغير)</label>
          <input type="email" disabled value="<%= user.email %>" class="block w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-500">
        </div>
        <button type="submit" class="w-full rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-700">حفظ الاسم</button>
      </div>
    </form>

    <form action="/account/password" method="POST" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-slate-900 mb-3">🔑 تغيير كلمة المرور</h2>
      <div class="space-y-3">
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">كلمة المرور الحالية</label>
          <input type="password" name="currentPassword" required autocomplete="current-password" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">كلمة المرور الجديدة</label>
          <input type="password" name="newPassword" required minlength="6" autocomplete="new-password" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">تأكيد كلمة المرور الجديدة</label>
          <input type="password" name="confirmPassword" required minlength="6" autocomplete="new-password" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
        </div>
        <button type="submit" class="w-full rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-700">تحديث كلمة المرور</button>
      </div>
    </form>
  </div>

  <% if (user.role === 'ADMIN') { %>
    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5">
      <h2 class="font-semibold text-amber-900 mb-2">👑 أنت أدمن</h2>
      <p class="text-sm text-amber-800">تقدر تدير المستخدمين والظهور من <a href="/admin" class="font-semibold underline">لوحة الأدمن</a>.</p>
    </div>
  <% } %>
</div>
