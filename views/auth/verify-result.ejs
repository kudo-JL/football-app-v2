<div class="max-w-lg mx-auto">
  <div class="rounded-2xl border <%= success ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50' %> p-8 text-center">
    <div class="text-6xl mb-4"><%= success ? '✅' : '❌' %></div>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">
      <%= success ? 'تم التفعيل بنجاح!' : 'تعذر التفعيل' %>
    </h1>
    <p class="text-slate-700 leading-relaxed mb-6">
      <%- message %>
    </p>
    <% if (success) { %>
      <a href="/" class="inline-block rounded-lg bg-emerald-600 px-6 py-3 text-white font-semibold hover:bg-emerald-700">
        🏠 الذهاب للرئيسية
      </a>
    <% } else { %>
      <a href="/login" class="inline-block rounded-lg border border-slate-300 bg-white px-6 py-3 text-slate-700 font-semibold hover:bg-slate-50">
        ← العودة لتسجيل الدخول
      </a>
    <% } %>
  </div>
</div>
