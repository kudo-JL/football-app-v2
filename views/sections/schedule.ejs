<div>
  <a href="/leagues/<%= league.id %>/sections/<%= section.id %>" class="text-sm text-slate-500 hover:text-slate-700">← <%= section.name %></a>

  <header class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">📅 البرنامج العام</h1>
      <p class="mt-1 text-sm text-slate-600"><%= section.name %> · موسم <%= league.season %></p>
    </div>
  </header>

  <% if (teams.length < 2) { %>
    <div class="mt-10 rounded-2xl border-2 border-dashed border-slate-300 bg-white p-10 text-center">
      <div class="text-5xl mb-3">📅</div>
      <h3 class="font-semibold text-slate-900">لا يمكن عرض البرنامج</h3>
      <p class="mt-2 text-sm text-slate-500">أضف فريقين على الأقل لتوليد البرنامج.</p>
      <a href="/leagues/<%= league.id %>/sections/<%= section.id %>" class="mt-4 inline-block rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white">← العودة للقسم</a>
    </div>
  <% } else { %>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm overflow-x-auto">
      <div class="mb-4 text-sm text-slate-600">
        📋 <strong><%= teams.length %></strong> فريق — موسم <strong><%= league.season %></strong>
      </div>

      <!-- Team grid -->
      <div class="grid gap-2" style="grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));">
        <% teams.forEach(t => { %>
          <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
            <% if (t.logo) { %>
              <img src="<%= t.logo %>" alt="<%= t.name %>" class="h-6 w-6 shrink-0 rounded-full object-cover" onerror="this.style.display='none'">
            <% } else { %>
              <div class="h-6 w-6 shrink-0 rounded-full text-[9px] font-bold text-white flex items-center justify-center" style="background-color: <%= t.color || '#64748b' %>">
                <%= (t.short_name || t.name).slice(0, 2).toUpperCase() %>
              </div>
            <% } %>
            <span class="truncate text-sm font-semibold text-slate-900"><%= t.name %></span>
          </div>
        <% }); %>
      </div>

      <% if (matchdays.length === 0) { %>
        <div class="mt-6 rounded-xl border-2 border-dashed border-amber-300 bg-amber-50 p-6 text-center">
          <div class="text-3xl mb-2">⚡</div>
          <h3 class="font-semibold text-amber-900">لم يتم توليد البرنامج بعد</h3>
          <p class="mt-2 text-sm text-amber-800">اذهب إلى صفحة المباريات لتوليد الجدول الكامل.</p>
          <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/matches" class="mt-4 inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-700">⚡ توليد البرنامج الكامل</a>
        </div>
      <% } else { %>
        <div class="mt-6">
          <p class="text-sm text-slate-600 mb-3">📊 <strong><%= matchdays.length %></strong> جولة، <strong><%= totalMatches %></strong> مباراة</p>
          <div class="grid gap-2">
            <% matchdays.forEach(m => { %>
              <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="rounded-full bg-blue-100 text-blue-800 text-xs font-bold w-8 h-8 flex items-center justify-center shrink-0"><%= m.order || '?' %></span>
                  <div class="min-w-0">
                    <div class="font-semibold text-slate-900 truncate"><%= m.name %></div>
                    <div class="text-xs text-slate-500"><%= m.match_count %> مباراة</div>
                  </div>
                </div>
                <span class="text-sm text-slate-400">→</span>
              </div>
            <% }); %>
          </div>
          <p class="mt-4 text-xs text-slate-500 italic">💡 الشبكة الكاملة للنتائج (ذهاب + إياب) ستضاف لاحقاً</p>
        </div>
      <% } %>
    </div>

    <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4">
      <p class="text-xs text-blue-900">
        💡 <strong>ملاحظة:</strong> الشبكة التفاعلية (Season Grid) مع نتائج الذهاب والإياب ستضاف في تحديث قادم.
      </p>
    </div>
  <% } %>
</div>
