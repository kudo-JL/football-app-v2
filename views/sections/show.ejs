<div>
  <a href="/leagues/<%= league.id %>" class="text-sm text-slate-500 hover:text-slate-700">← <%= league.name %></a>

  <header class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-3xl font-bold text-slate-900"><%= section.name %></h1>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">#<%= section.order %></span>
      </div>
      <% if (section.notes) { %>
        <p class="mt-2 text-sm text-slate-600"><%= section.notes %></p>
      <% } %>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if (teams.length >= 2) { %>
        <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/standings" class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700">📊 ترتيب متقدم</a>
      <% } %>
      <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/edit" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">✏️ تعديل</a>
      <form action="/leagues/<%= league.id %>/sections/<%= section.id %>/delete" method="POST" onsubmit="return confirm('حذف القسم وكل فرقه؟')" class="inline">
        <button class="rounded-lg border border-red-300 bg-white px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-50">🗑️ حذف</button>
      </form>
    </div>
  </header>

  <% if (error) { %>
    <div class="mt-4 rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700"><%= error %></div>
  <% } %>
  <% if (generated) { %>
    <div class="mt-4 rounded-lg bg-emerald-50 border border-emerald-200 p-3 text-sm text-emerald-800">✅ تم توليد <strong><%= generated %></strong> مباراة بنجاح</div>
  <% } %>

  <section class="mt-10">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <h2 class="text-xl font-bold text-slate-900">الفرق (<%= teams.length %>)</h2>
      <div class="flex gap-2 flex-wrap">
        <% if (teams.length >= 2) { %>
          <button onclick="document.getElementById('generateFixtureModal').classList.remove('hidden')" class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-700">⚡ توليد الجدول الكامل</button>
        <% } %>
        <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/teams/new" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ فريق جديد</a>
      </div>
    </div>

    <% if (teams.length === 0) { %>
      <div class="rounded-2xl border-2 border-dashed border-slate-300 bg-white p-10 text-center">
        <div class="text-5xl mb-3">⚽</div>
        <h3 class="font-semibold text-slate-900">لا توجد فرق</h3>
        <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/teams/new" class="mt-4 inline-block rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white">+ أضف أول فريق</a>
      </div>
    <% } else { %>
      <div class="grid gap-3 sm:grid-cols-2">
        <% teams.forEach(t => { %>
          <div class="group flex items-center justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md <%= t.status === 'RELEGATED' ? 'border-red-200 bg-red-50/50' : t.status === 'PROMOTED' ? 'border-emerald-200 bg-emerald-50/50' : '' %>">
            <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/teams/<%= t.id %>/edit" class="flex items-center gap-3 min-w-0 flex-1">
            <div class="flex items-center gap-3 min-w-0">
              <% if (t.logo) { %>
                <img src="<%= t.logo %>" alt="" class="h-10 w-10 shrink-0 rounded-full object-cover border-2 border-white shadow" onerror="this.style.display='none'">
              <% } else { %>
                <div class="h-10 w-10 shrink-0 rounded-full text-sm font-bold text-white flex items-center justify-center" style="background-color: <%= t.color || '#64748b' %>">
                  <%= (t.short_name || t.name).slice(0, 2).toUpperCase() %>
                </div>
              <% } %>
              <div class="min-w-0">
                <div class="truncate font-semibold text-slate-900 group-hover:text-emerald-600"><%= t.name %></div>
                <% if (t.short_name) { %>
                  <div class="text-xs text-slate-500"><%= t.short_name %></div>
                <% } %>
              </div>
            </div>
            <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-medium <%= t.status === 'RELEGATED' ? 'bg-red-100 text-red-800 ring-1 ring-red-300' : t.status === 'PROMOTED' ? 'bg-emerald-100 text-emerald-800 ring-1 ring-emerald-300' : 'bg-slate-100 text-slate-700' %>"><%= t.status === 'PROMOTED' ? 'صاعد' : t.status === 'RELEGATED' ? 'نازل' : 'نشط' %></span>
            <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/teams/<%= t.id %>/players" class="shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50" title="إدارة اللاعبين" onclick="event.stopPropagation()">👥</a>
          </div>
        <% }); %>
      </div>
    <% } %>
  </section>

  <section class="mt-10">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <h2 class="text-xl font-bold text-slate-900">الجولات (<%= matchdays.length %>)</h2>
      <div class="flex gap-2 flex-wrap">
        <% if (teams.length >= 2) { %>
          <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/h2h" class="rounded-lg border border-purple-300 bg-white px-4 py-2 text-sm font-semibold text-purple-700 hover:bg-purple-50">🤝 المواجهات المباشرة</a>
        <% } %>
        <% if (matchdays.length > 0) { %>
          <button onclick="document.getElementById('resetMatchesModal').classList.remove('hidden')" class="rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">🗑️ حذف كل المباريات</button>
        <% } %>
        <form action="/leagues/<%= league.id %>/sections/<%= section.id %>/matchdays/new" method="POST" class="flex gap-2">
          <input type="text" name="name" required placeholder="اسم الجولة (مثل: الجولة 1)" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
          <button class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ جولة</button>
        </form>
      </div>
    </div>

    <% if (matchdays.length === 0) { %>
      <p class="text-sm text-slate-500">لا توجد جولات بعد. <span class="text-purple-600">جرّب زر توليد الجدول الكامل</span> بعد إضافة فريقين.</p>
    <% } else { %>
      <div class="space-y-2">
        <% matchdays.forEach(m => { %>
          <%
            var status = m.match_count === 0 ? 'empty' : (m.finished_count === m.match_count ? 'completed' : (m.finished_count > 0 ? 'partial' : 'pending'));
            var statusBadge = '';
            var statusIcon = '';
            if (status === 'completed') { statusBadge = '<span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-800">✓ مكتملة</span>'; statusIcon = '✅'; }
            else if (status === 'partial') { statusBadge = '<span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-semibold text-amber-800">جزئية ' + m.finished_count + '/' + m.match_count + '</span>'; statusIcon = '⏳'; }
            else if (status === 'pending') { statusBadge = '<span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">لم تبدأ</span>'; statusIcon = '🕐'; }
            else { statusBadge = '<span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-500">فارغة</span>'; statusIcon = '📭'; }
          %>
          <a href="/leagues/<%= league.id %>/sections/<%= section.id %>/matchdays/<%= m.id %>" class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md">
            <div class="flex items-center gap-3">
              <span class="text-2xl"><%= statusIcon %></span>
              <div>
                <h3 class="font-semibold text-slate-900"><%= m.name %></h3>
                <p class="text-sm text-slate-500"><%= m.match_count %> مباراة · <%= m.finished_count %> منتهية</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <%- statusBadge %>
              <span class="text-sm text-slate-400">←</span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>
</div>

<!-- Generate Fixture Modal -->
<div id="generateFixtureModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4" onclick="if(event.target===this) this.classList.add('hidden')">
  <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
    <h3 class="text-xl font-bold text-slate-900">⚡ توليد الجدول الكامل</h3>
    <p class="mt-2 text-sm text-slate-600">سيتم إنشاء جميع جولات الذهاب والإياب تلقائياً مع تناوب داخل/خارج الملعب.</p>
    <p class="mt-1 text-xs text-red-600 font-semibold">⚠️ هذا سيحذف أي جدول موجود مسبقاً في هذا القسم.</p>
    <form action="/leagues/<%= league.id %>/sections/<%= section.id %>/generate-fixture" method="POST" class="mt-4 space-y-3">
      <div>
        <label class="mb-1 block text-sm font-medium text-slate-700">تاريخ أول جولة (اختياري)</label>
        <input type="date" name="startDate" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-slate-700">أيام بين كل جولة</label>
        <input type="number" name="daysBetween" min="1" max="30" value="7" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" name="includeReturn" id="includeReturn" value="1" checked class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500">
        <label for="includeReturn" class="text-sm text-slate-700">تضمين جولات الإياب (ذهاب + إياب)</label>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('generateFixtureModal').classList.add('hidden')" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">إلغاء</button>
        <button type="submit" class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-700">توليد</button>
      </div>
    </form>
  </div>
</div>

<!-- Reset Matches Modal -->
<div id="resetMatchesModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4" onclick="if(event.target===this) this.classList.add('hidden')">
  <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
    <h3 class="text-xl font-bold text-red-700">🗑️ حذف كل الجولات والمباريات</h3>
    <p class="mt-2 text-sm text-slate-600">سيتم حذف جميع الجولات والمباريات وتصفير إحصائيات الفرق.</p>
    <p class="mt-1 text-xs text-red-600 font-semibold">⚠️ هذا الإجراء لا يمكن التراجع عنه.</p>
    <form action="/leagues/<%= league.id %>/sections/<%= section.id %>/reset-matches" method="POST" class="mt-4 space-y-3">
      <div>
        <label class="mb-1 block text-sm font-medium text-slate-700">اكتب <span class="font-mono font-bold text-red-700">DELETE</span> للتأكيد:</label>
        <input type="text" name="confirm" required class="block w-full rounded-lg border border-red-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500" placeholder="DELETE">
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('resetMatchesModal').classList.add('hidden')" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">إلغاء</button>
        <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">احذف كل شي</button>
      </div>
    </form>
  </div>
</div>
